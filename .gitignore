# ---- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
# Root-scoped: a bare "build/" would also swallow data/build/, where the
# committed panel lives.
/build/
/dist/

# ---- Jupyter --------------------------------------------------------------
.ipynb_checkpoints/

# ---- Virtual environments -------------------------------------------------
.venv/
venv/
env/
ENV/

# ---- R / RStudio ----------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# ---- Quarto (if a team uses Quarto for the write-up) ----------------------
.quarto/
_freeze/
_site/

# ---- Data -----------------------------------------------------------------
# Raw upstream downloads are cached locally and never committed -- the cache
# runs to several GB (QCEW alone is ~300MB per year). Anyone can rebuild it:
#     python -m housing_pipeline build
data/cache/

data/raw/
data/external/
data/interim/
*.csv.gz
*.parquet
*.feather

# The built panel and feature table ARE committed (a few MB as Parquet), so
# results are reproducible without a network connection or an API key.
!data/build/panel.parquet
!data/build/features.parquet
*.h5
*.hdf5
*.pkl
*.pickle
*.sqlite
*.db
*.arrow

# ---- Model artifacts ------------------------------------------------------
models/*.pt
models/*.h5
models/*.pkl
models/*.bin
models/*.onnx
models/*.joblib

# ---- Logs and temp --------------------------------------------------------
*.log
logs/
tmp/
*.tmp

# ---- Secrets and credentials ---------------------------------------------
# Never commit credentials. If you accidentally do, rotate the secret first.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# ---- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
